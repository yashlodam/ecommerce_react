# ==============================================================================
# SHOPSPHERE FRONTEND (REACT/VITE) — ENVIRONMENT VARIABLES
# ==============================================================================
# In production (Render, Vercel, Netlify):
# Set VITE_API_BASE_URL to your deployed Spring Boot backend URL (no trailing slash).
#
# Example:
# VITE_API_BASE_URL=https://ecommerce-multivendor-ywdy.onrender.com
#
# In local development:
# Point to local Spring Boot (http://localhost:5454) or leave empty to use Vite proxy
# VITE_API_BASE_URL=http://localhost:5454
#
# (VITE_API_URL is also supported as a backwards-compatible alias)

